# Copy to a host-only file, restrict its permissions, and edit the paths.
FREETOKEN_CHECKOUT=/opt/FreeToken
FREETOKEN_PYTHON=/opt/FreeToken/.venv/bin/python
MODEL_PATH=/srv/models/DeepSeek-V4.1-Flash

# Logical order is significant: authority RTX 5090, worker RTX 5090,
# modified 48 GiB RTX 4090, modified 32 GiB RTX 4080 SUPER. All four are text
# ranks; logical device 3 also runs native vision. Prefer stable GPU UUIDs in
# this host-only file and never commit them.
DSV41_CUDA_VISIBLE_DEVICES=0,1,2,3
DSV41_TEXT_GPUS=0,1,2,3
DSV41_VISION_DEVICE=3
DSV41_HOST=127.0.0.1
DSV41_PORT=8080
DSV41_SERVED_MODEL_NAME='DeepSeek (Experimental)'

DSV41_CONTEXT=1048576
DSV41_MAX_PREFILL_LENGTH=8192
DSV41_NUM_PAGES=8192
DSV41_SWA_FULL_TOKENS_RATIO=0.140625
DSV41_MAX_RUNNING_REQUESTS=2
DSV41_MOE_CACHE_SIZES=240,1536,2494,1552
DSV41_DECODE_EXPERT_SHARDS=16,136,160,72
DSV41_PREFILL_EXPERT_SHARDS=112,128,112,32
DSV41_EXPERT_STORAGE_RANGES=0:112,16:224,144:208,288:96
DSV41_ENGRAM_RANKS=0,1
DSV41_MOE_PREFILL_HIT_D2D=1
DSV41_SPARSE_PREFILL_MAX_TOKENS=256
DSV41_CACHE_TYPE=radix
DSV41_REASONING_EFFORT=25
DSV41_TEMPERATURE=1.0
DSV41_TOP_P=0.95

DSV41_MOE_BACKEND=hybrid
DSV41_MOE_CPU_THREADS=24
DSV41_MOE_HYBRID_RANKS=1,2
DSV41_MOE_HYBRID_MAX_FETCH=1
DSV41_MOE_HYBRID_MAX_BS=2

DSV41_NCCL_P2P_DISABLE=0
DSV41_NCCL_P2P_LEVEL=SYS
DSV41_MEMORY_RATIO=0.90
DSV41_DECODE_LOG_INTERVAL=8
DSV41_TVM_FFI_CACHE_DIR=/tmp/freetoken-dsv41-tvm-cache
DSV41_KERNEL_CACHE_DIR=/tmp/freetoken-dsv41-kernel-cache

# Exact packed storage for the checkpoint's already-rounded compressed main KV.
# These three startup-only switches were qualified together at 1M context.
FREETOKEN_DSV41_PACKED_KV=1
FREETOKEN_DSV41_PACKED_PREFILL_GLUON=1
FREETOKEN_DSV41_PACKED_DECODE_STAGE=1
