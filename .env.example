# Copy to .env (or another host-only file) and edit paths.
FREETOKEN_CHECKOUT=/home/USER/models/worktrees/FreeToken-dsv41-flash
FREETOKEN_PYTHON=/home/USER/FreeToken/.venv/bin/python
MODEL_PATH=/home/USER/models/DeepSeek-V4.1-Flash

# CUDA_VISIBLE_DEVICES accepts indices or stable GPU UUIDs. FreeToken then sees
# these two devices as logical GPUs 0 and 1.
DSV41_CUDA_VISIBLE_DEVICES=0,1
DSV41_HOST=172.17.0.1
DSV41_PORT=8080
DSV41_SERVED_MODEL_NAME='DeepSeek (Experimental)'

DSV41_CONTEXT=65536
DSV41_MAX_PREFILL_LENGTH=4096
DSV41_NUM_PAGES=512
DSV41_SWA_FULL_TOKENS_RATIO=0.28125
DSV41_MOE_CACHE_SIZES=704,1450
DSV41_MOE_PREFILL_HIT_D2D=1
DSV41_CACHE_TYPE=radix
DSV41_REASONING_EFFORT=25
DSV41_TEMPERATURE=1.0
DSV41_TOP_P=0.95

DSV41_CUDA_GRAPH=1
DSV41_INDEXER_MAX_LOGITS_MB=512
DSV41_NCCL_P2P_DISABLE=1
DSV41_MEMORY_RATIO=0.90
DSV41_DECODE_LOG_INTERVAL=8
DSV41_TVM_FFI_CACHE_DIR=/tmp/freetoken-dsv41-tvm-cache
