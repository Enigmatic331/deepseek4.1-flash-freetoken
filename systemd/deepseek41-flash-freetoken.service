[Unit]
Description=DeepSeek V4.1 Flash 512K EP3 on FreeToken with native vision
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=exec
User=deepseek
Group=deepseek
WorkingDirectory=/opt/deepseek41-flash-freetoken
Environment=DSV41_CONFIG=/etc/deepseek41-flash-freetoken.env
ExecStart=/opt/deepseek41-flash-freetoken/scripts/run.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity
TimeoutStopSec=5min
LimitMEMLOCK=infinity
LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal
SyslogIdentifier=deepseek41-flash-freetoken

[Install]
WantedBy=multi-user.target
